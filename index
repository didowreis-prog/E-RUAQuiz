let questions = [...DEFAULT_QUESTIONS];
const answers = {};
const audioStore = {};
let index = 0;
let typingToken = 0;
let submissionCompleted = false;

const $ = id => document.getElementById(id);
const qEl = $('question');
const subEl = $('sub');
const boxEl = $('answers');
const nextBtn = $('next');
const backBtn = $('back');

let typing = null;

async function carregarPerguntasRemotas() {
  const statusEl = $('sync-status');
  const labelEl = $('sync-label');

  if (!SCRIPT_URL || SCRIPT_URL.includes('COLE_SUA_URL_AQUI')) {
    labelEl.textContent = 'Modo padrão (Planilha offline)';
    statusEl.className = 'sync-indicator offline';
    return;
  }

  try {
    labelEl.textContent = 'Carregando da planilha…';
    const res = await fetch(SCRIPT_URL + '?action=getQuestions', { method: 'GET' });
    const data = await res.json();
    if (data.success && Array.isArray(data.questions) && data.questions.length > 0) {
      questions = data.questions.map(q => {
        if (q.id === 'frequencia') {
          q.skipIf = a => a.usa === 'Não';
        }
        return q;
      });
      labelEl.textContent = 'Perguntas sincronizadas (Sheets: ' + (data.spreadsheetName || 'QUIZ 10-26') + ')';
      statusEl.className = 'sync-indicator online';
    } else {
      labelEl.textContent = 'Perguntas locais ativas';
    }
  } catch (err) {
    labelEl.textContent = 'Modo local (Sheets inacessível)';
    statusEl.className = 'sync-indicator offline';
  }
}

carregarPerguntasRemotas();

function typeText(el, text, speed = 8) {
  return new Promise(resolve => {
    if (typing) finishTyping();
    const state = { el, full: text, resolve, i: 0, timer: null };
    typing = state;
    el.textContent = '';
    el.classList.add('caret');

    const step = () => {
      if (typing !== state) return;
      if (state.i >= text.length) { finishTyping(); return; }
      
      const stepSize = text.length > 120 ? 3 : text.length > 50 ? 2 : 1;
      state.i = Math.min(text.length, state.i + stepSize);
      el.textContent = text.slice(0, state.i);
      
      const s = text.length > 100 ? Math.max(5, speed * 0.4)
              : text.length > 40  ? Math.max(6, speed * 0.6)
              : speed;
      state.timer = setTimeout(step, s);
    };
    state.timer = setTimeout(step, speed);
  });
}

function finishTyping() {
  if (!typing) return;
  const s = typing;
  typing = null;
  clearTimeout(s.timer);
  s.el.textContent = s.full;
  s.el.classList.remove('caret');
  s.resolve();
}

document.addEventListener('click', e => {
  if (typing && !e.target.closest('.opt, .btn, .scale__btn, .tag, .duration-chip, .duration-tab, .duration-step-btn, .audio__btn')) {
    finishTyping();
  }
});

function nextIndex(from, dir) {
  let j = from + dir;
  while (j >= 0 && j < questions.length) {
    const q = questions[j];
    if (!q.skipIf || !q.skipIf(answers)) return j;
    j += dir;
  }
  return -1;
}

function isAnswered(q) {
  const v = answers[q.id];
  if (v === undefined || v === null) return false;
  if (Array.isArray(v)) return v.some(x => String(x).trim().length > 0);
  if (typeof v === 'object') {
    if (v.blob) return true;
    if (v.text && String(v.text).trim().length > 0) return true;
    if (v.audio && v.audio.blob) return true;
    return false;
  }
  return String(v).trim().length > 0;
}

function canAdvance() {
  const q = questions[index];
  return q.optional ? true : isAnswered(q);
}

function checkNav() {
  nextBtn.disabled = !canAdvance();
  backBtn.disabled = nextIndex(index, -1) === -1;
}

async function showQuestion(i) {
  index = i;
  const q = questions[i];
  const token = ++typingToken;

  boxEl.className = 'answers';
  boxEl.innerHTML = '';
  subEl.textContent = '';
  subEl.classList.remove('show');
  nextBtn.disabled = true;
  backBtn.disabled = true;

  $('count').textContent = String(i + 1).padStart(2, '0') + ' / ' + questions.length;
  $('bar').style.width = ((i) / questions.length * 100) + '%';

  $('hint').classList.add('show');
  await typeText(qEl, q.q, 8);
  $('hint').classList.remove('show');

  if (token !== typingToken) return;
  if (q.sub) { subEl.textContent = q.sub; subEl.classList.add('show'); }

  renderAnswers(q, boxEl);
  boxEl.classList.add('show');
  checkNav();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function goNext() {
  if (!canAdvance()) return;
  const n = nextIndex(index, 1);
  if (n === -1) finish();
  else showQuestion(n);
}

function goPrev() {
  const p = nextIndex(index, -1);
  if (p !== -1) showQuestion(p);
}

function renderDurationPicker(q, box, prev) {
  let currentUnit = 'anos';
  let currentValue = 1;

  if (prev && typeof prev === 'string') {
    const match = prev.match(/(\d+|\<1|30\+)\s*(meses?|anos?)/i);
    if (match) {
      if (match[2].toLowerCase().startsWith('m')) {
        currentUnit = 'meses';
        currentValue = parseInt(match[1]) || 1;
      } else {
        currentUnit = 'anos';
        currentValue = match[1] === '<1' ? 0.5 : (parseInt(match[1]) || 1);
      }
    }
  }

  const wrap = document.createElement('div');
  wrap.className = 'duration-picker';
  wrap.innerHTML = `
    <div class="duration-tabs">
      <button type="button" class="duration-tab ${currentUnit === 'meses' ? 'is-active' : ''}" data-unit="meses">Meses</button>
      <button type="button" class="duration-tab ${currentUnit === 'anos' ? 'is-active' : ''}" data-unit="anos">Anos</button>
    </div>
    <div class="duration-quick" id="duration-chips"></div>
    <div class="duration-stepper">
      <button type="button" class="duration-step-btn" id="step-dec" aria-label="Diminuir">−</button>
      <div class="duration-value-display" id="duration-val">
        <span>${currentValue}</span> ${currentUnit === 'meses' ? (currentValue === 1 ? 'mês' : 'meses') : (currentValue === 1 ? 'ano' : 'anos')}
      </div>
      <button type="button" class="duration-step-btn" id="step-inc" aria-label="Aumentar">+</button>
    </div>
  `;

  const chipsContainer = wrap.querySelector('#duration-chips');
  const valDisplay = wrap.querySelector('#duration-val');
  const tabs = wrap.querySelectorAll('.duration-tab');
  const decBtn = wrap.querySelector('#step-dec');
  const incBtn = wrap.querySelector('#step-inc');

  const updateDisplay = () => {
    let text = '';
    if (currentUnit === 'meses') {
      text = currentValue === 1 ? `${currentValue} mês` : `${currentValue} meses`;
    } else {
      text = currentValue === 1 ? `${currentValue} ano` : `${currentValue} anos`;
    }
    valDisplay.innerHTML = `<span>${currentValue}</span> ${currentUnit === 'meses' ? (currentValue === 1 ? 'mês' : 'meses') : (currentValue === 1 ? 'ano' : 'anos')}`;
    answers[q.id] = text;
    checkNav();
  };

  const renderChips = () => {
    chipsContainer.innerHTML = '';
    const presets = currentUnit === 'meses'
      ? [1, 2, 3, 4, 6, 8, 10, 11]
      : [1, 2, 3, 4, 5, 8, 10, 15, 20, 25, 30];

    presets.forEach(num => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'duration-chip' + (currentValue === num ? ' is-sel' : '');
      chip.textContent = num + (currentUnit === 'meses' ? (num === 1 ? ' mês' : ' meses') : (num === 1 ? ' ano' : ' anos'));
      chip.addEventListener('click', () => {
        currentValue = num;
        wrap.querySelectorAll('.duration-chip').forEach(c => c.classList.remove('is-sel'));
        chip.classList.add('is-sel');
        updateDisplay();
      });
      chipsContainer.appendChild(chip);
    });
  };

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      currentUnit = tab.dataset.unit;
      currentValue = currentUnit === 'meses' ? 6 : 2;
      renderChips();
      updateDisplay();
    });
  });

  decBtn.addEventListener('click', () => {
    if (currentValue > 1) {
      currentValue -= 1;
      renderChips();
      updateDisplay();
    }
  });

  incBtn.addEventListener('click', () => {
    const max = currentUnit === 'meses' ? 36 : 50;
    if (currentValue < max) {
      currentValue += 1;
      renderChips();
      updateDisplay();
    }
  });

  renderChips();
  updateDisplay();
  box.appendChild(wrap);
}

function createAudioRecorder(qid, prevAudio, onUpdate) {
  const wrap = document.createElement('div');
  wrap.className = 'audio';
  wrap.innerHTML = `
    <div class="audio__stage">
      <button type="button" class="audio__btn" data-role="rec">
        <span class="audio__dot"></span>
        <span class="audio__label">Gravar áudio</span>
      </button>
      <div class="audio__timer">00:00</div>
    </div>
    <div class="audio__play" hidden>
      <audio controls preload="metadata"></audio>
      <button type="button" class="audio__redo">Regravar</button>
    </div>
    <div class="audio__hint">Sua fala será salva no Google Drive (pasta E-RUA 27) e no AppSheet.</div>
  `;

  const recBtn = wrap.querySelector('[data-role="rec"]');
  const recLabel = wrap.querySelector('.audio__label');
  const timerEl = wrap.querySelector('.audio__timer');
  const playBox = wrap.querySelector('.audio__play');
  const audioEl = wrap.querySelector('audio');
  const redoBtn = wrap.querySelector('.audio__redo');

  let mediaRecorder = null;
  let chunks = [];
  let timerInt = null;
  let secs = 0;
  let stream = null;

  const fmt = s => String(Math.floor(s/60)).padStart(2,'0') + ':' + String(s%60).padStart(2,'0');

  function setRecording(on) {
    wrap.classList.toggle('is-rec', on);
    recLabel.textContent = on ? 'Parar gravação' : 'Gravar áudio';
  }

  async function startRec() {
    try {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (err) {
      recLabel.textContent = 'Microfone indisponível';
      return;
    }
    chunks = [];
    const mime = MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : 'audio/mp4';
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
    mediaRecorder.onstop = () => {
      const blob = new Blob(chunks, { type: chunks[0]?.type || mime });
      const url = URL.createObjectURL(blob);
      audioEl.src = url;
      playBox.hidden = false;
      const data = { blob, url, duration: secs, type: blob.type };
      audioStore[qid] = data;
      onUpdate(data);
      stream.getTracks().forEach(t => t.stop());
    };
    mediaRecorder.start();
    secs = 0;
    timerEl.textContent = '00:00';
    setRecording(true);
    timerInt = setInterval(() => { secs++; timerEl.textContent = fmt(secs); }, 1000);
  }

  function stopRec() {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
    clearInterval(timerInt);
    setRecording(false);
  }

  recBtn.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state === 'recording') stopRec();
    else startRec();
  });

  redoBtn.addEventListener('click', () => {
    if (audioStore[qid]?.url) URL.revokeObjectURL(audioStore[qid].url);
    delete audioStore[qid];
    playBox.hidden = true;
    audioEl.src = '';
    timerEl.textContent = '00:00';
    secs = 0;
    onUpdate(null);
  });

  if (prevAudio && prevAudio.url) {
    audioEl.src = prevAudio.url;
    playBox.hidden = false;
    timerEl.textContent = fmt(prevAudio.duration || 0);
  }

  return wrap;
}

function renderAnswers(q, box) {
  const prev = answers[q.id];

  /* 1. CONSENTIMENTO */
  if (q.type === 'consent') {
    const wrap = document.createElement('div');
    wrap.className = 'consent';
    wrap.innerHTML = `
      <div class="smiley-wrap">
        <svg class="smiley" viewBox="0 0 120 120" fill="none" aria-hidden="true">
          <circle cx="60" cy="60" r="52" stroke="currentColor" stroke-width="5"/>
          <circle class="eye eye--l" cx="42" cy="48" r="6" fill="currentColor"/>
          <circle class="eye eye--r" cx="78" cy="48" r="6" fill="currentColor"/>
          <path class="mouth" d="M 34 74 Q 60 100 86 74" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="opts opts--big">
        <button type="button" class="opt" data-v="Sim, quero ajudar">
          <span class="opt__txt">Sim, quero ajudar</span>
        </button>
        <button type="button" class="opt" data-v="Agora não">
          <span class="opt__txt">Agora não</span>
        </button>
      </div>
    `;
    wrap.querySelectorAll('.opt').forEach(b => {
      b.addEventListener('click', () => {
        const v = b.dataset.v;
        answers[q.id] = v;
        wrap.querySelectorAll('.opt').forEach(c => c.classList.remove('is-sel'));
        b.classList.add('is-sel');
        setTimeout(() => {
          if (v === 'Agora não') politeEnd();
          else goNext();
        }, 420);
      });
    });
    box.appendChild(wrap);
    return;
  }

  /* 2. TEXTO CURTO */
  if (q.type === 'text') {
    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'input';
    input.placeholder = q.placeholder || 'Digite aqui…';
    input.value = typeof prev === 'string' ? prev : '';
    input.addEventListener('input', () => {
      answers[q.id] = input.value.trim();
      checkNav();
    });
    input.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); if (canAdvance()) goNext(); }
    });
    box.appendChild(input);
    setTimeout(() => input.focus(), 80);
    return;
  }

  /* 3. TEXTO LONGO */
  if (q.type === 'textarea') {
    const ta = document.createElement('textarea');
    ta.className = 'textarea';
    ta.placeholder = q.placeholder || 'Escreva com liberdade…';
    ta.value = typeof prev === 'string' ? prev : '';
    ta.addEventListener('input', () => {
      answers[q.id] = ta.value.trim();
      checkNav();
      ta.style.height = 'auto';
      ta.style.height = Math.max(140, ta.scrollHeight) + 'px';
    });
    box.appendChild(ta);
    setTimeout(() => ta.focus(), 80);
    return;
  }

  /* 4. CAMPO HÍBRIDO (ESCRITA + ÁUDIO) */
  if (q.type === 'text_audio') {
    const container = document.createElement('div');
    container.className = 'hybrid-field';

    const currentText = (typeof prev === 'object' && prev !== null) ? (prev.text || '') : (typeof prev === 'string' ? prev : '');
    const currentAudio = (typeof prev === 'object' && prev !== null) ? (prev.audio || (prev.blob ? prev : null)) : (audioStore[q.id] || null);

    const ta = document.createElement('textarea');
    ta.className = 'textarea';
    ta.placeholder = q.placeholder || 'Escreva sua resposta aqui se preferir digitar…';
    ta.value = currentText;

    const syncHybrid = () => {
      const stateObj = {
        text: ta.value.trim(),
        audio: audioStore[q.id] || null
      };
      answers[q.id] = stateObj;
      checkNav();
    };

    ta.addEventListener('input', () => {
      syncHybrid();
      ta.style.height = 'auto';
      ta.style.height = Math.max(130, ta.scrollHeight) + 'px';
    });

    container.appendChild(ta);

    const div = document.createElement('div');
    div.className = 'hybrid-divider';
    div.textContent = 'ou responda gravando áudio';
    container.appendChild(div);

    const audioWidget = createAudioRecorder(q.id, currentAudio, (audioData) => {
      if (audioData) audioStore[q.id] = audioData;
      else delete audioStore[q.id];
      syncHybrid();
    });

    container.appendChild(audioWidget);
    box.appendChild(container);

    syncHybrid();
    setTimeout(() => ta.focus(), 80);
    return;
  }

  /* 5. SELETOR DE DURAÇÃO */
  if (q.type === 'duration') {
    renderDurationPicker(q, box, prev);
    return;
  }

  /* 6. TAGS DE ESCOLHA MÚLTIPLA */
  if (q.type === 'tags') {
    const sel = Array.isArray(prev) ? prev.slice() : [];
    const wrap = document.createElement('div');
    wrap.className = 'tags';

    const optsList = Array.isArray(q.options) ? q.options : DEFAULT_FUNCIONALIDADES;

    optsList.forEach((opt, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'tag' + (sel.includes(opt) ? ' is-sel' : '');
      b.textContent = opt;
      b.style.animationDelay = (i * 35) + 'ms';
      b.addEventListener('click', () => {
        const pos = sel.indexOf(opt);
        if (pos === -1) { sel.push(opt); b.classList.add('is-sel'); }
        else { sel.splice(pos, 1); b.classList.remove('is-sel'); }
        answers[q.id] = sel.slice();
        if (outrosBox) outrosBox.classList.toggle('show', sel.includes('Outros'));
        checkNav();
      });
      wrap.appendChild(b);
    });
    box.appendChild(wrap);

    let outrosBox = null;
    if (optsList.includes('Outros')) {
      outrosBox = document.createElement('input');
      outrosBox.type = 'text';
      outrosBox.className = 'input outros-input' + (sel.includes('Outros') ? ' show' : '');
      outrosBox.placeholder = 'Se marcou "Outros", especifique…';
      outrosBox.value = answers[q.id + '_outros'] || '';
      outrosBox.addEventListener('input', () => {
        answers[q.id + '_outros'] = outrosBox.value.trim();
      });
      box.appendChild(outrosBox);
    }
    return;
  }

  /* 7. OPÇÃO ÚNICA (RADIO) */
  if (q.type === 'radio') {
    const wrap = document.createElement('div');
    wrap.className = 'opts' + (q.big ? ' opts--big' : '');
    const optsList = Array.isArray(q.options) ? q.options : ['Sim', 'Não'];

    optsList.forEach(opt => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'opt' + (prev === opt ? ' is-sel' : '');
      b.innerHTML = '<span class="opt__mark"></span><span class="opt__txt"></span>';
      b.querySelector('.opt__txt').textContent = opt;

      b.addEventListener('click', () => {
        const myIndex = index;
        answers[q.id] = opt;
        [...wrap.children].forEach(c => c.classList.remove('is-sel'));
        b.classList.add('is-sel');
        checkNav();
        setTimeout(() => { if (index === myIndex && canAdvance()) goNext(); }, 420);
      });
      wrap.appendChild(b);
    });
    box.appendChild(wrap);
    return;
  }

  /* 8. MÚLTIPLA ESCOLHA (CHECKBOX) */
  if (q.type === 'checkbox') {
    const sel = Array.isArray(prev) ? prev.slice() : [];
    const wrap = document.createElement('div');
    wrap.className = 'opts';
    const optsList = Array.isArray(q.options) ? q.options : DEFAULT_FUNCIONALIDADES;

    optsList.forEach(opt => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'opt opt--check' + (sel.includes(opt) ? ' is-sel' : '');
      b.innerHTML = '<span class="opt__mark"></span><span class="opt__txt"></span>';
      b.querySelector('.opt__txt').textContent = opt;

      b.addEventListener('click', () => {
        const pos = sel.indexOf(opt);
        if (pos === -1) { sel.push(opt); b.classList.add('is-sel'); }
        else { sel.splice(pos, 1); b.classList.remove('is-sel'); }
        answers[q.id] = sel.slice();
        checkNav();
      });
      wrap.appendChild(b);
    });
    box.appendChild(wrap);
    return;
  }

  /* 9. ESCALA 1 A 5 */
  if (q.type === 'scale') {
    const wrap = document.createElement('div');
    wrap.className = 'scale';
    [1,2,3,4,5].forEach(n => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'scale__btn' + (String(prev) === String(n) ? ' is-sel' : '');
      b.textContent = n;
      b.addEventListener('click', () => {
        const myIndex = index;
        answers[q.id] = n;
        [...wrap.children].forEach(c => c.classList.remove('is-sel'));
        b.classList.add('is-sel');
        checkNav();
        setTimeout(() => { if (index === myIndex && canAdvance()) goNext(); }, 420);
      });
      wrap.appendChild(b);
    });
    const labels = document.createElement('div');
    labels.className = 'scale__labels';
    labels.innerHTML = '<span>Ruim</span><span>Ótimo</span>';

    const holder = document.createElement('div');
    holder.appendChild(wrap);
    holder.appendChild(labels);
    box.appendChild(holder);
    return;
  }

  /* 10. TRÊS PRIORIDADES */
  if (q.type === 'triple') {
    const vals = Array.isArray(prev) ? prev.slice() : ['','',''];
    const wrap = document.createElement('div');
    wrap.className = 'triple';
    [0,1,2].forEach(i => {
      const row = document.createElement('div');
      row.className = 'row';
      const num = document.createElement('span');
      num.className = 'num';
      num.textContent = (i + 1) + 'ª';
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'input';
      input.placeholder = i === 0 ? 'Prioridade máxima' : (i === 1 ? 'Segunda prioridade' : 'Terceira prioridade');
      input.value = vals[i] || '';
      input.addEventListener('input', () => {
        vals[i] = input.value.trim();
        answers[q.id] = vals.slice();
        checkNav();
      });
      input.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const all = wrap.querySelectorAll('input');
          if (i < 2) all[i + 1].focus();
          else if (canAdvance()) goNext();
        }
      });
      row.appendChild(num);
      row.appendChild(input);
      wrap.appendChild(row);
    });
    box.appendChild(wrap);
    setTimeout(() => wrap.querySelector('input')?.focus(), 80);
    return;
  }
}

function blobToBase64(blob) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onloadend = () => resolve(reader.result);
    reader.onerror = reject;
    reader.readAsDataURL(blob);
  });
}

async function enviarParaPlanilha() {
  const statusEl = $('cloud-status');
  const protoEl = $('cloud-protocol');
  const retryBtn = $('cloud-retry');

  if (!SCRIPT_URL || SCRIPT_URL.includes('COLE_SUA_URL_AQUI')) {
    statusEl.textContent = 'Respostas salvas localmente (Script URL não configurada).';
    statusEl.className = 'cloud-box__status';
    return;
  }

  statusEl.textContent = 'Enviando respostas e áudios para QUIZ 10-26 (E-RUA 27)…';
  statusEl.className = 'cloud-box__status';
  retryBtn.style.display = 'none';

  try {
    const payloadAudios = {};
    for (const qid in audioStore) {
      const audioData = audioStore[qid];
      if (audioData && audioData.blob) {
        statusEl.textContent = 'Codificando áudio da pergunta ' + qid + '…';
        const b64 = await blobToBase64(audioData.blob);
        payloadAudios[qid] = {
          base64: b64,
          mimeType: audioData.type || 'audio/webm',
          extensao: audioData.type && audioData.type.includes('mp4') ? 'mp4' : 'webm',
          duration: audioData.duration || 0
        };
      }
    }

    const payload = {
      respostas: answers,
      audios: payloadAudios,
      timestamp: new Date().toISOString()
    };

    statusEl.textContent = 'Gravando na planilha QUIZ 10-26…';

    const resp = await fetch(SCRIPT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    });

    const resJson = await resp.json();

    if (resJson.success) {
      submissionCompleted = true;
      statusEl.textContent = 'Sincronizado com sucesso na planilha QUIZ 10-26 e AppSheet! ✓';
      statusEl.className = 'cloud-box__status sent';
      protoEl.textContent = 'Protocolo: ' + resJson.protocolo;
    } else {
      throw new Error(resJson.error || 'Erro desconhecido na planilha.');
    }
  } catch (err) {
    statusEl.textContent = 'Falha no envio para a nuvem. Suas respostas continuam salvas abaixo.';
    statusEl.className = 'cloud-box__status error';
    retryBtn.style.display = 'inline-flex';
  }
}

$('cloud-retry').addEventListener('click', enviarParaPlanilha);

