function renderSummary() {
  const summary = $('summary');
  summary.innerHTML = '';
  questions.forEach(q => {
    const v = answers[q.id];
    if (v === undefined || v === null) return;
    if (Array.isArray(v) && !v.some(x => String(x).trim())) return;
    if (typeof v === 'string' && !v.trim()) return;

    const item = document.createElement('div');
    item.className = 'summary__item';

    const qt = document.createElement('div');
    qt.className = 'summary__q';
    qt.textContent = q.q;
    item.appendChild(qt);

    const at = document.createElement('div');
    at.className = 'summary__a';

    if (typeof v === 'object' && (v.text !== undefined || v.audio !== undefined)) {
      if (v.text && v.text.trim()) {
        const textNode = document.createElement('p');
        textNode.textContent = v.text;
        at.appendChild(textNode);
      }
      if (v.audio && v.audio.blob) {
        const label = document.createElement('div');
        label.style.marginTop = v.text ? '10px' : '0';
        label.textContent = 'Áudio gravado · ' + fmtSecs(v.audio.duration || 0);
        at.appendChild(label);
        const a = document.createElement('audio');
        a.controls = true;
        a.src = v.audio.url;
        at.appendChild(a);
        const dl = document.createElement('a');
        dl.href = v.audio.url;
        dl.download = 'e-rua-' + q.id + '.webm';
        dl.className = 'summary__dl';
        dl.textContent = 'Baixar áudio';
        at.appendChild(dl);
      }
      item.appendChild(at);
    } else {
      let text = Array.isArray(v) ? v.filter(x => String(x).trim()).join(' · ') : v;
      const extra = answers[q.id + '_outros'];
      if (q.type === 'tags' && extra && Array.isArray(v) && v.includes('Outros')) {
        text = text.replace('Outros', 'Outros: ' + extra);
      }
      at.textContent = text;
      item.appendChild(at);
    }

    summary.appendChild(item);
  });
}

function fmtSecs(s) {
  const m = Math.floor(s/60), r = s % 60;
  return String(m).padStart(2,'0') + ':' + String(r).padStart(2,'0');
}

function buildReport() {
  let out = 'E-RUA — ESCUTA COM OS TRABALHADORES\n';
  out += 'Consultório na Rua · SEAS · Vila Velha\n';
  out += 'Data: ' + new Date().toLocaleString('pt-BR') + '\n';
  out += '='.repeat(52) + '\n\n';
  questions.forEach((q, i) => {
    const v = answers[q.id];
    if (v === undefined || v === null) return;
    if (Array.isArray(v) && !v.some(x => String(x).trim())) return;
    if (typeof v === 'string' && !v.trim()) return;
    out += String(i + 1).padStart(2, '0') + '. ' + q.q + '\n';

    if (typeof v === 'object' && (v.text !== undefined || v.audio !== undefined)) {
      if (v.text && v.text.trim()) out += '    [Texto]: ' + v.text + '\n';
      if (v.audio && v.audio.blob) out += '    [Áudio gravado · ' + fmtSecs(v.audio.duration || 0) + ']\n';
      out += '\n';
    } else {
      let text = Array.isArray(v) ? v.filter(x => String(x).trim()).join(' | ') : v;
      const extra = answers[q.id + '_outros'];
      if (q.type === 'tags' && extra && Array.isArray(v) && v.includes('Outros')) {
        text = text.replace('Outros', 'Outros: ' + extra);
      }
      out += '    ' + text + '\n\n';
    }
  });
  return out;
}

$('copy').addEventListener('click', async () => {
  const btn = $('copy');
  try {
    const report = buildReport();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(report);
    } else {
      const t = document.createElement('textarea');
      t.value = report;
      document.body.appendChild(t);
      t.select();
      document.execCommand('copy');
      document.body.removeChild(t);
    }
    btn.textContent = 'Copiado ✓';
  } catch {
    btn.textContent = 'Não foi possível copiar';
  }
  setTimeout(() => { btn.textContent = 'Copiar respostas'; }, 2200);
});

$('download').addEventListener('click', () => {
  const blob = new Blob([buildReport()], { type: 'text/plain;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'e-rua-escuta-' + new Date().toISOString().slice(0,10) + '.txt';
  a.click();
  URL.revokeObjectURL(a.href);
});

